# =====================================================================
#  CONFIGURAÇÕES DO ROBÔ
#  1. Faça uma cópia deste arquivo com o nome  .env
#  2. Troque o que está depois do sinal de  =  (sem espaços em volta)
#  NUNCA mostre o arquivo .env para ninguém: ele tem a sua chave secreta.
# =====================================================================

# Sua chave do Gemini. Crie grátis em: https://aistudio.google.com/apikey
GEMINI_API_KEY=cole_sua_chave_aqui

# (Opcional) Chave de RESERVA, de um projeto com cobrança ativada (paga).
# Só é usada quando a chave grátis bate o limite ou falha. Em branco = sem reserva.
GEMINI_API_KEY_RESERVA=

# (Opcional) Número do WhatsApp do ROBÔ, com 55 + DDD + número, só números.
# Preenchido: conecta com CÓDIGO (use quando o robô roda no mesmo celular do número).
# Em branco: conecta com QR Code.
NUMERO_DO_ROBO=

# Nome do seu negócio, do jeito que o robô vai falar para o cliente
NOME_DO_NEGOCIO=Loja Exemplo

# SEU WhatsApp pessoal (não o do robô), com 55 + DDD + número, só números.
# É para onde vai o aviso quando o cliente pedir para falar com uma pessoa.
SEU_WHATSAPP_PESSOAL=5511999999999

# Seu nome como aparece nas conversas exportadas (ajuda o robô a saber quem é você).
# Pode deixar em branco: ele tenta descobrir sozinho.
SEU_NOME_NAS_CONVERSAS=

# Horário em que o robô responde. Em branco = 24 horas.
# Exemplo: 08:00-18:00  (fora desse horário ele fica quieto e a mensagem de ausência do WhatsApp Business avisa o cliente)
HORARIO_ATENDIMENTO=

# Depois que o cliente pede uma pessoa, o robô fica quieto com ele por quantos minutos
PAUSA_APOS_CHAMAR_HUMANO_MINUTOS=60

# Modelo do Gemini. Só troque se der erro de "modelo não encontrado".
GEMINI_MODELO=gemini-flash-lite-latest

# Porta da página do QR Code (http://localhost:3008)
PORTA=3008
